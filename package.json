{
	"name": "editable-website",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"data:help": "./scripts/data.sh help",
		"data:pull": "./scripts/data.sh pull",
		"data:push": "./scripts/data.sh push",
		"data:backup": "./scripts/data.sh backup",
		"data:backups": "./scripts/data.sh backups",
		"data:restore": "./scripts/data.sh restore",
		"data:restore-cloud": "./scripts/data.sh restore-cloud",
		"data:pull-cloud": "./scripts/data.sh pull-cloud",
		"data:cloud-snapshots": "./scripts/data.sh cloud-snapshots",
		"data:reset": "./scripts/data.sh reset",
		"litestream:install": "./scripts/install-litestream.sh"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.1",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.1"
	},
	"dependencies": {
		"@jsquash/webp": "^1.5.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"aws4fetch": "^1.0.20",
		"nanoid": "^5.1.6",
		"slugify": "^1.6.6",
		"svedit": "^0.12.0",
		"valibot": "^1.4.1"
	}
}
